      "expression": "SUM(FACT_SALES_MONTHLY[BILL_COUNT_CURRENT]) - CALCULATE(SUM(FACT_SALES_MONTHLY[BILL_COUNT_CURRENT]), SAMEPERIODLASTYEAR(DIM_CALENDAR[DATE]))",
