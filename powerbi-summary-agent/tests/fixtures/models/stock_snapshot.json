  "measures": [
    {
      "name": "Stock Units on Hand",
      "table": "FACT_STOCK",
      "expression": "CALCULATE(SUM(FACT_STOCK[STOCK_UNITS]), LASTNONBLANK(FACT_STOCK[SNAPSHOT_DATE], 1))",
      "format_string": "",
      "description": "Units held as at the latest snapshot in context.",
      "display_folder": "",
      "is_hidden": false
    },
    {
      "name": "Stock Value on Hand",
      "table": "FACT_STOCK",
      "expression": "CALCULATE(SUM(FACT_STOCK[STOCK_VALUE]), LASTNONBLANK(FACT_STOCK[SNAPSHOT_DATE], 1))",
      "format_string": "#,0",
      "description": "Stock value as at the latest snapshot in context.",
      "display_folder": "",
      "is_hidden": false
    },
    {
      "name": "Stock Units Naive Sum",
      "table": "FACT_STOCK",
      "expression": "SUM(FACT_STOCK[STOCK_UNITS])",
      "format_string": "",
      "description": "Incorrect across more than one snapshot. Present as a test control.",
      "display_folder": "",
      "is_hidden": false
    },
    {
      "name": "Stock Value Current Snapshot",
      "table": "FACT_STOCK",
      "expression": "CALCULATE(SUM(FACT_STOCK[STOCK_VALUE]), LASTNONBLANK(FACT_STOCK[SNAPSHOT_DATE], 1))",
      "format_string": "#,0",
      "description": "",
      "display_folder": "",
      "is_hidden": false
    },
    {
      "name": "Average Daily Units Sold",
      "table": "FACT_SALES",
      "expression": "AVERAGEX(VALUES(FACT_SALES[TRANSACTION_DATE]), SUM(FACT_SALES[SOLD_UNITS]))",
      "format_string": "",
      "description": "",
      "display_folder": "",
      "is_hidden": false
    },
    {
      "name": "Days Cover",
      "table": "FACT_STOCK",
      "expression": "DIVIDE([Stock Units on Hand], [Average Daily Units Sold])",
      "format_string": "0.0",
      "description": "Days of cover at the current rate of sale.",
      "display_folder": "",
      "is_hidden": false
    }
  ],
