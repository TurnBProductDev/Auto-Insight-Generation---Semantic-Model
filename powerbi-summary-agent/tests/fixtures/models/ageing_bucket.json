  "measures": [
    {
      "name": "Ageing Value Current",
      "table": "FACT_STOCK_AGEING",
      "expression": "CALCULATE(SUM(FACT_STOCK_AGEING[AGEING_VALUE]), LASTNONBLANK(FACT_STOCK_AGEING[SNAPSHOT_DATE], 1))",
      "format_string": "#,0",
      "description": "Stock value by age band as at the current snapshot.",
      "display_folder": "",
      "is_hidden": false
    },
    {
      "name": "Ageing Value Prior Snapshot",
      "table": "FACT_STOCK_AGEING",
      "expression": "CALCULATE(SUM(FACT_STOCK_AGEING[AGEING_VALUE]), LASTNONBLANK(FACT_STOCK_AGEING[SNAPSHOT_DATE], 1))",
      "format_string": "#,0",
      "description": "The same measure at the previous snapshot.",
      "display_folder": "",
      "is_hidden": false
    },
    {
      "name": "Ageing Value Change",
      "table": "FACT_STOCK_AGEING",
      "expression": "[Ageing Value Current] - [Ageing Value Prior Snapshot]",
      "format_string": "#,0",
      "description": "Signed movement between the two snapshots.",
      "display_folder": "",
      "is_hidden": false
    },
    {
      "name": "Ageing Units Current",
      "table": "FACT_STOCK_AGEING",
      "expression": "CALCULATE(SUM(FACT_STOCK_AGEING[AGEING_UNITS]), LASTNONBLANK(FACT_STOCK_AGEING[SNAPSHOT_DATE], 1))",
      "format_string": "",
      "description": "",
      "display_folder": "",
      "is_hidden": false
    },
    {
      "name": "Ageing Units Prior Snapshot",
      "table": "FACT_STOCK_AGEING",
      "expression": "CALCULATE(SUM(FACT_STOCK_AGEING[AGEING_UNITS]), LASTNONBLANK(FACT_STOCK_AGEING[SNAPSHOT_DATE], 1))",
      "format_string": "",
      "description": "",
      "display_folder": "",
      "is_hidden": false
    },
    {
      "name": "Ageing Units Change",
      "table": "FACT_STOCK_AGEING",
      "expression": "[Ageing Units Current] - [Ageing Units Prior Snapshot]",
      "format_string": "",
      "description": "",
      "display_folder": "",
      "is_hidden": false
    },
    {
      "name": "Share of Value Over 90 Days",
      "table": "FACT_STOCK_AGEING",
      "expression": "DIVIDE(CALCULATE([Ageing Value Current], DIM_AGE_BUCKET[AGE_BUCKET_SORT] = 4), [Ageing Value Current])",
      "format_string": "0.0%",
      "description": "Higher is worse.",
      "display_folder": "",
      "is_hidden": false
    }
  ],
