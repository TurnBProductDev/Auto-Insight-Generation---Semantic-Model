# -------------------------------------------------------------------
# Copy this file to `.env` (same directory) and fill in your values.
# `.env` is gitignored and must never be committed.
#
#   cp .env.example .env
#
# main.py loads this file via python-dotenv before any node runs.
# -------------------------------------------------------------------

# Which LLM backend to use: azure_openai | anthropic | openai
# Overrides `ai_provider` in config.json when set.
LLM_PROVIDER=azure_openai

# --- Azure OpenAI (LLM_PROVIDER=azure_openai) ---
# NOTE: For Azure, the DEPLOYMENT name selects the model, not `model` in config.json.
AZURE_OPENAI_API_KEY=PASTE_YOUR_AZURE_OPENAI_KEY
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# --- Anthropic (LLM_PROVIDER=anthropic) ---
# ANTHROPIC_API_KEY=PASTE_YOUR_ANTHROPIC_KEY

# --- OpenAI (LLM_PROVIDER=openai) ---
# OPENAI_API_KEY=PASTE_YOUR_OPENAI_KEY

# --- Power BI (optional) ---
# Overrides `tenant_id` in config.json if you prefer to keep the tenant
# out of the committed JSON. Leave unset to use config.json's value.
# POWERBI_TENANT_ID=00000000-0000-0000-0000-000000000000

# --- Azure Blob upload (optional) ---
# When `azure_blob_upload: true` in config.json, each run pushes
# outputs/api/*.json to the configured container (default: insightgen).
# Easiest headless auth: paste the storage account's connection string here
# (Portal > Storage account > Access keys > Connection string).
# Without it, upload falls back to your `az login` (needs the
# 'Storage Blob Data Contributor' role on the account).
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
