# -------------------------------------------------------------------
# Copy this file to `.env` (same directory) and fill in your values.
# `.env` is gitignored and must never be committed.
#
#   cp .env.example .env
#
# main.py loads this file via python-dotenv before any node runs.
# -------------------------------------------------------------------

# Which LLM backend to use: azure_openai | anthropic | openai
# Overrides `ai_provider` in config.json when set.
LLM_PROVIDER=azure_openai

# --- Azure OpenAI (LLM_PROVIDER=azure_openai) ---
# NOTE: For Azure, the DEPLOYMENT name selects the model, not `model` in config.json.
AZURE_OPENAI_API_KEY=PASTE_YOUR_AZURE_OPENAI_KEY
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# --- Anthropic (LLM_PROVIDER=anthropic) ---
# ANTHROPIC_API_KEY=PASTE_YOUR_ANTHROPIC_KEY

# --- OpenAI (LLM_PROVIDER=openai) ---
# OPENAI_API_KEY=PASTE_YOUR_OPENAI_KEY

# --- Power BI (optional) ---
# Overrides `tenant_id` in config.json if you prefer to keep the tenant
# out of the committed JSON. Leave unset to use config.json's value.
# POWERBI_TENANT_ID=00000000-0000-0000-0000-000000000000
# POWERBI_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
# POWERBI_DATASET_ID=00000000-0000-0000-0000-000000000000

# How Power BI / Fabric tokens are acquired (overrides `powerbi_auth_mode` in
# config.json): auto | interactive | managed_identity | service_principal
#   auto (default)   -> managed_identity inside Azure, interactive on a laptop
#   interactive      -> MSAL browser login + .pbi_token_cache.json (local dev)
#   managed_identity -> Azure MI via DefaultAzureCredential (no cache file)
#   service_principal-> app-only via the AZURE_* vars below (also headless/local)
# POWERBI_AUTH_MODE=auto

# DAX query wire format: auto | json | arrow
#   auto (default) -> legacy JSON for interactive local runs; Arrow for
#                     managed-identity/service-principal runs in Azure/CI
#   json           -> force the legacy /executeQueries endpoint
#   arrow          -> force the newer /executeDaxQueries endpoint
# POWERBI_QUERY_API=auto

# Optional RLS impersonation for the Arrow endpoint. Leave BOTH unset for the
# normal whole-model InsightGen run. Service principals can send roles only
# when they are workspace Admins; the current Contributor identity does not
# need either setting to query the complete model.
# POWERBI_EFFECTIVE_USERNAME=regional.user@example.com
# POWERBI_RLS_ROLES=["RegionalSales"]

# User-assigned managed identity: set its client id so DefaultAzureCredential
# picks the right identity (omit for a system-assigned identity).
# AZURE_MANAGED_IDENTITY_CLIENT_ID=00000000-0000-0000-0000-000000000000

# App-only service principal (service_principal mode, or headless local/CI).
# DefaultAzureCredential reads these automatically. The SP must be enabled for
# Power BI APIs and added to the workspace as Member/Contributor.
# AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_SECRET=PASTE_YOUR_CLIENT_SECRET

# --- Azure Blob upload (optional) ---
# When `azure_blob_upload: true` in config.json, each run pushes
# outputs/api/*.json to the configured container (default: insightgen).
# Easiest headless auth: paste the storage account's connection string here
# (Portal > Storage account > Access keys > Connection string).
# Without it, upload falls back to your `az login` (needs the
# 'Storage Blob Data Contributor' role on the account).
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

# --- Cloud insight memory (optional) ---
# Set `insight_memory_storage` to `azure_blob` in config.json. The authoritative
# memory then lives in the private `insightstate` container; the existing local
# insight_memory/ directory is not migrated. Initialize it once with:
#   python scripts/initialize_cloud_memory.py

# Optional stable id for a non-Azure scheduler/retry wrapper. Container Apps
# Jobs provide CONTAINER_APP_JOB_EXECUTION_NAME automatically, so do not set
# this there. Retries with the same id cannot overwrite existing history.
# INSIGHT_HISTORY_RUN_ID=scheduled-execution-id

# --- Docker / Azure Container Apps Job runtime configuration ---
# The Docker image deliberately excludes config/config.json. It starts from the
# committed config template and these values select the actual cloud target.
# AGENT_CONFIG_PATH=/app/config/config.example.json
# AGENT_OUTPUT_FOLDER=outputs
# AZURE_BLOB_UPLOAD=true
# AZURE_BLOB_ACCOUNT=your-storage-account
# AZURE_BLOB_CONTAINER=insightgen
# AZURE_BLOB_PREFIX=
# AZURE_BLOB_HISTORY_PREFIX=history
# AZURE_BLOB_HISTORY_FEED=insight_history.json
# INSIGHT_HISTORY_ENABLED=true
# INSIGHT_HISTORY_TIMEZONE=Asia/Kolkata
# INSIGHT_MEMORY_STORAGE=azure_blob
# INSIGHT_MEMORY_RUNTIME_FOLDER=outputs/.runtime/insight_memory
# AZURE_BLOB_MEMORY_CONTAINER=insightstate
# AZURE_BLOB_MEMORY_PREFIX=

# Optional JSON object for non-secret tuning values that are not represented by
# a dedicated env var. Named env vars above take precedence over this object.
# AGENT_CONFIG_OVERRIDES_JSON={"insight_max_new_per_run":8,"insight_excluded_entities":["STORE_NEW"]}
