{
  "tenant_id":    "PASTE_YOUR_TENANT_ID",
  "workspace_id": "PASTE_YOUR_WORKSPACE_ID",
  "dataset_id":   "PASTE_YOUR_DATASET_ID",
  "output_folder": "outputs",
  "summary_word_limit": 800,
  "fresh_summary_enabled": true,
  "fresh_summary_max_words": 220,
  "summary_visual_enabled": true,
  "summary_candidates_max": 12,
  "summary_temporal_batch_share": 0.5,
  "summary_delayed_after_periods": 1,
  "summary_stale_after_periods": 2,
  "summary_memory_enabled": true,
  "summary_memory_storage": "local",
  "summary_memory_runtime_folder": "outputs/.runtime/summary_memory",
  "summary_memory_policy": "never_repeat",
  "summary_memory_cooldown_days": 14,
  "summary_history_enabled": true,
  "summary_history_timezone": "Asia/Kolkata",
  "max_rows_per_query": 15,

  "ai_provider": "azure_openai",
  "model": "claude-sonnet-5",
  "azure_openai_api_key_env": "AZURE_OPENAI_API_KEY",
  "openai_api_key_env": "OPENAI_API_KEY",
  "anthropic_api_key_env": "ANTHROPIC_API_KEY",
  "max_tokens": 8192,

  "execution_mode": "python",
  "fabric_definitions": true,
  "powerbi_auth_mode": "auto",
  "powerbi_query_api": "auto",
  "powerbi_effective_username": "",
  "powerbi_rls_roles": [],

  "insight_max_signals": 15,
  "insight_max_investigation_rounds": 9,
  "insight_max_scan_queries": 20,
  "insight_probe_max_rows": 20,
  "insight_materiality_pct": 1.0,
  "insight_max_dq_signals": 2,
  "insight_tiles_enabled": false,
  "insight_history_enabled": true,
  "insight_history_timezone": "Asia/Kolkata",
  "insight_memory_storage": "local",
  "insight_memory_runtime_folder": "outputs/.runtime/insight_memory",

  "metadata_scope_max_entities": 500,
  "insight_metadata_max_dimensions": 5,
  "insight_total_gap_scan_budget": 30,
  "insight_max_gap_dimensions_per_signal": 3,

  "insight_comparable_population": [],
  "insight_excluded_entities": [],

  "insight_stat_z_cutoff": 3.0,
  "insight_stat_concentration_pct": 50.0,
  "insight_stat_recon_tolerance_pct": 2.0,
  "insight_stat_trend_window": 3,
  "insight_stat_max_candidates": 20,

  "azure_blob_upload": false,
  "azure_blob_account": "PASTE_YOUR_STORAGE_ACCOUNT",
  "azure_blob_container": "insightgen",
  "azure_blob_prefix": "",
  "azure_blob_history_prefix": "history",
  "azure_blob_history_feed": "insight_history.json",
  "azure_blob_memory_container": "insightstate",
  "azure_blob_memory_prefix": "",
  "azure_blob_summary_memory_prefix": "summary-memory",
  "azure_blob_summary_history_prefix": "summary-history",
  "azure_blob_summary_history_feed": "summary_history.json",

  "ai_content_publish_enabled": false,
  "ai_content_client": "",
  "ai_content_report_ids": [],
  "ai_content_ttl_hours": 24,
  "ai_content_alert_days": 7
}
